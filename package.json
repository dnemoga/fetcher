{
  "name": "@dnemoga/fetcher",
  "version": "1.3.0",
  "description": "A minimalistic library built around the native Fetch API with zero dependencies.",

  "type": "module",

  "keywords": [
    "http-client",
    "fetch",
    "promise",
    "typescript",
    "javascript"
  ],

  "license": "MIT",

  "author": "Dmytro Nemoga <dnemoga@gmail.com>",
  "repository": "https://github.com/dnemoga/fetcher",
  "bugs": "https://github.com/dnemoga/fetcher/issues",

  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],

  "scripts": {
    "build": "tsc --project tsconfig.build.json --outDir lib",
    "build:watch": "npm run build -- --watch",

    "test": "jest src",
    "test:watch": "npm run test -- --watch",

    "lint": "eslint src"
  },

  "devDependencies": {
    "@types/jest": "29.5.14",
    "jest": "29.7.0",
    "ts-jest": "29.3.2",
    "ts-node": "10.9.2",
    "typescript": "5.8.3"
  }
}
